{
  "kind": "collectionType",
  "collectionName": "testimonials",
  "info": {
    "singularName": "testimonial",
    "pluralName": "testimonials",
    "displayName": "Testimonial",
    "description": "Customer/partner testimonials shown on the Testimonials page and homepage"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "authorName": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "role": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "quote": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "rating": {
      "type": "integer",
      "min": 1,
      "max": 5,
      "default": 5,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "featured": { "type": "boolean", "default": false, "pluginOptions": { "i18n": { "localized": false } } },
    "order": { "type": "integer", "default": 0, "pluginOptions": { "i18n": { "localized": false } } }
  }
}
