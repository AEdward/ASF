{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Page-builder pages made of orderable sections"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "sections": {
      "type": "dynamiczone",
      "pluginOptions": { "i18n": { "localized": true } },
      "components": [
        "sections.hero",
        "sections.video",
        "sections.glance",
        "sections.mission",
        "sections.feature-grid",
        "sections.stats-band",
        "sections.intro",
        "sections.story-panel",
        "sections.team-grid"
      ]
    }
  }
}
