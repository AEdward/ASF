{
  "kind": "collectionType",
  "collectionName": "partners",
  "info": {
    "singularName": "partner",
    "pluralName": "partners",
    "displayName": "Partner",
    "description": "Partner organizations shown on the Partners page and homepage marquee"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "name": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": false } } },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "description": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "websiteUrl": { "type": "string", "pluginOptions": { "i18n": { "localized": false } } },
    "category": {
      "type": "enumeration",
      "enum": ["Government", "Financial", "Distribution", "International", "Other"],
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
