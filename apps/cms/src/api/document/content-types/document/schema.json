{
  "kind": "collectionType",
  "collectionName": "documents",
  "info": {
    "singularName": "document",
    "pluralName": "documents",
    "displayName": "Document",
    "description": "Downloadable documents shown on the Documents library page"
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": {
    "i18n": { "localized": true }
  },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files", "images"],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "category": {
      "type": "enumeration",
      "enum": ["Company Profile", "Certification", "Product Spec", "Policy", "Report", "Other"],
      "default": "Other",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": { "type": "integer", "default": 0, "pluginOptions": { "i18n": { "localized": false } } }
  }
}
